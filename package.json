{
  "name": "dsh-aiterm",
  "version": "0.5.0",
  "description": "SSH and Telnet terminals for DeepSeek Harness: one real terminal shared by you and the AI, with per-session AI permissions and token-cheap delta reads.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rj-yejianping/dsh-aiterm.git"
  },
  "homepage": "https://github.com/rj-yejianping/dsh-aiterm#readme",
  "bugs": {
    "url": "https://github.com/rj-yejianping/dsh-aiterm/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "terminal",
    "ssh",
    "telnet",
    "xterm",
    "ai-agent",
    "automation",
    "collaboration"
  ],
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CONTRACTS.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "lint": "node --check lib/index.js && for f in lib/host/*.js lib/host/transports/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node scripts/smoke-client.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
